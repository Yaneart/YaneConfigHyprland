#!/usr/bin/env bash
set -euo pipefail

theme="$HOME/.config/rofi/wallset.rasi"
WALL_DIR="$HOME/.config/wallpapers"
CWD="$(pwd)"

cd "$WALL_DIR" || exit

# Список файлов-обоев (отсортирован)
mapfile -t files < <(
  find . -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" \) \
    -printf '%P\n' | sort
)

# Красивое имя из файла: убрать расширение, _/- -> пробел, Каждое Слово С Заглавной
pretty() {
  local n="${1%.*}"
  n="${n//_/ }"
  n="${n//-/ }"
  sed -E 's/\b(.)/\u\1/g' <<<"$n"
}

# Меню: плитка-превью (icon = сам файл) + красивое имя под ней
chosen_name=$(
  for file in "${files[@]}"; do
    printf '%s\0icon\x1f%s\n' "$(pretty "$file")" "$WALL_DIR/$file"
  done | rofi -dmenu -p "Select Wallpaper" -theme "$theme"
)

# Обратный маппинг красивого имени -> реальный файл
if [ -n "$chosen_name" ]; then
  for file in "${files[@]}"; do
    if [ "$(pretty "$file")" = "$chosen_name" ]; then
      "$HOME/.local/bin/theme-apply" "$WALL_DIR/$file"
      break
    fi
  done
fi

cd "$CWD" || exit

#!/usr/bin/env bash
set -euo pipefail

WAYBAR_DIR="$HOME/.config/waybar"
STATE_FILE="$HOME/.local/state/theme/current_waybar_style"
MODE="${1:-style}"
FILE="${2:-}"

restart_waybar() {
  pkill -x waybar >/dev/null 2>&1 || true
  nohup waybar >/dev/null 2>&1 &
  disown
}

# Style changes are picked up seamlessly by waybar's reload_style_on_change
# (it watches style.css), so no restart is needed. Just make sure it runs.
ensure_waybar() {
  if ! pgrep -x waybar >/dev/null 2>&1; then
    nohup waybar >/dev/null 2>&1 &
    disown
  fi
}

if [ -z "$FILE" ]; then
  notify-send "Waybar" "No file selected"
  exit 1
fi

case "$MODE" in
  style)
    cat >"$WAYBAR_DIR/style.css" <<EOF

/* This file is generated by ~/.local/bin/waybar-set */

@import "colors.css"; /* import matugen colors */
@import "colors-waybar.css"; /* import wallust colors */


@import url('${FILE}'); /* import style  */

EOF
    echo "$FILE" > "$STATE_FILE"
    ensure_waybar
    notify-send "Waybar" "Style applied: $(basename "$FILE")"
    ;;
  config)
    cp "$FILE" "$WAYBAR_DIR/config.jsonc"
    restart_waybar
    notify-send "Waybar" "Config applied: $(basename "$FILE")"
    ;;
  *)
    notify-send "Waybar" "Unknown mode: $MODE"
    exit 1
    ;;
esac

#!/usr/bin/env python3
"""Вживляет сгенерированную matugen палитру в VSCode settings.json как
workbench.colorCustomizations. Заменяет/вставляет ТОЛЬКО этот ключ, остальной
файл (порядок ключей, пустые строки-группировка, комментарии) сохраняется
байт-в-байт. Вызывается из matugen post_hook при смене обоев.

settings.json официального VSCode читает colorCustomizations вживую — окно
перезапускать не нужно, цвета меняются сразу.
"""
import colorsys
import json
import os
import sys
import tempfile

HOME = os.path.expanduser("~")
COLORS = os.path.join(HOME, ".config/matugen/generated/vscode-colors.json")
SETTINGS = os.path.join(HOME, ".config/Code/User/settings.json")
KEY = "workbench.colorCustomizations"

# --- Насколько "кричащим" делать акцент (роль primary) ТОЛЬКО в VSCode ---
# Палитра matugen у тебя приглушённая (пастельная), поэтому акцент здесь
# дополнительно «накачивается»: насыщенность ×SAT (с потолком 1.0), а яркость
# подтягивается к сочной середине L_TARGET. Крути эти два числа:
#   ACCENT_SAT   1.0 = как есть · 2.0 ярче · 3.0+ почти максимум
#   ACCENT_L_TARGET  целевая яркость (0.5 темнее/гуще · 0.7 светлее)
#   ACCENT_L_MIX     насколько тянуть к L_TARGET (0 = не трогать яркость · 1 = ровно L_TARGET)
ACCENT_SAT = 2.6
ACCENT_L_TARGET = 0.62
ACCENT_L_MIX = 0.7


def boost(hex6):
    """Возвращает более насыщенную/сочную версию #rrggbb того же тона."""
    r = int(hex6[1:3], 16) / 255
    g = int(hex6[3:5], 16) / 255
    b = int(hex6[5:7], 16) / 255
    h, l, s = colorsys.rgb_to_hls(r, g, b)
    s = min(1.0, s * ACCENT_SAT)
    l = l * (1 - ACCENT_L_MIX) + ACCENT_L_TARGET * ACCENT_L_MIX
    r, g, b = colorsys.hls_to_rgb(h, l, s)
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def boost_accent(colors):
    """Накачивает каждое вхождение акцента (включая варианты с альфой #rrggbbAA)."""
    accent = colors.get("focusBorder", "")  # в шаблоне focusBorder == primary
    if len(accent) != 7 or not accent.startswith("#"):
        return colors
    loud = boost(accent)
    a = accent.lower()
    out = {}
    for k, v in colors.items():
        if isinstance(v, str) and v.lower().startswith(a):
            out[k] = loud + v[len(accent):]   # сохраняем суффикс альфы, если был
        else:
            out[k] = v
    return out


def value_span(text, key_quote_pos):
    """Возвращает (start, end) объекта-значения {...} для ключа."""
    colon = text.index(":", key_quote_pos)
    i = colon + 1
    while i < len(text) and text[i] != "{":
        i += 1
    if i >= len(text):
        raise ValueError("no object value after key")
    start, depth, in_str, esc = i, 0, False, False
    while i < len(text):
        c = text[i]
        if in_str:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                return start, i + 1
        i += 1
    raise ValueError("unbalanced braces in settings.json")


def render(colors):
    """JSON-объект с отступом 2; первая строка '{' остаётся inline после ключа,
    остальные строки сдвигаются на 2 пробела (уровень ключа верхнего уровня)."""
    body = json.dumps(colors, indent=2, ensure_ascii=False)
    lines = body.split("\n")
    return lines[0] + "\n" + "\n".join("  " + ln for ln in lines[1:])


def main():
    if not os.path.exists(SETTINGS):
        sys.exit(0)  # VSCode не настроен — молча выходим
    with open(COLORS, encoding="utf-8") as f:
        colors = json.load(f)
    colors = boost_accent(colors)
    with open(SETTINGS, encoding="utf-8") as f:
        text = f.read()

    value = render(colors)
    needle = '"%s"' % KEY
    pos = text.find(needle)
    if pos != -1:
        start, end = value_span(text, pos)
        new_text = text[:start] + value + text[end:]
    else:
        brace = text.index("{")
        new_text = text[:brace + 1] + '\n  %s: %s,' % (needle, value) + text[brace + 1:]

    # проверяем, что результат — валидный JSON, прежде чем перезаписывать
    json.loads(new_text)

    d = os.path.dirname(SETTINGS)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".settings.", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(new_text)
        os.replace(tmp, SETTINGS)
    except BaseException:
        os.path.exists(tmp) and os.remove(tmp)
        raise


if __name__ == "__main__":
    main()

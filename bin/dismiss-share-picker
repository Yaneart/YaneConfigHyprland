#!/usr/bin/env python3
"""Listens to Hyprland IPC and auto-closes hyprland-share-picker."""

import os
import socket
import subprocess
import time

def get_socket_path():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    return f"{runtime}/hypr/{sig}/.socket2.sock"

def close_picker():
    time.sleep(0.15)
    subprocess.run(
        ["hyprctl", "dispatch", "closewindow", "class:^(hyprland-share-picker)$"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

def main():
    path = get_socket_path()
    while True:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(path)
                buf = b""
                while True:
                    data = s.recv(4096)
                    if not data:
                        break
                    buf += data
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        event = line.decode(errors="ignore")
                        # openwindow>>address,workspace,class,title
                        if event.startswith("openwindow>>"):
                            parts = event[len("openwindow>>"):].split(",", 3)
                            if len(parts) >= 3 and parts[2] == "hyprland-share-picker":
                                close_picker()
        except Exception:
            time.sleep(2)

if __name__ == "__main__":
    main()

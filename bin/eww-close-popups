#!/usr/bin/env bash
# Закрывает оба eww-попапа с анимацией: сначала прячем карточку (reveal=false),
# ждём длительность crossfade, затем закрываем окна и сбрасываем флаги.
# Вызывается: фоном оверлея (клик мимо) и non-consuming-биндом Escape в Hyprland.
# Escape ловится глобально, поэтому сначала одним IPC-вызовом проверяем, открыт ли
# вообще хоть один попап — иначе выходим, не дёргая eww close и не уходя в sleep.
case "$(eww active-windows 2>/dev/null)" in
  *dashboard*|*battery*) ;;   # есть открытый попап — продолжаем закрытие
  *) exit 0 ;;
esac

eww update reveal_dash=false reveal_bat=false >/dev/null 2>&1
sleep 0.16
eww close dashboard battery >/dev/null 2>&1
eww update dash_open=false bat_open=false >/dev/null 2>&1

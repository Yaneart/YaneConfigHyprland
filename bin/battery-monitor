#!/usr/bin/env bash
# battery-monitor — уведомления о низком заряде батареи (ThinkPad Power Bridge:
# BAT0 внутренняя + BAT1 в отсеке). upowerd не запущен, штатных уведомлений нет.
#
# Поведение по запросу пользователя: НИКАКОЙ гибернации и вольтажных страховок —
# батарея просто разряжается до 0. Только всплывающие напоминания на порогах:
#   20% — пора подумать о зарядке (обычное)
#   15% — заряд низкий (внимание)
#   10% — критично
#    5% — подключай срочно
#
# Процент считается по САМОЙ ЗАРЯЖЕННОЙ (живой) батарее, а не по сумме: Power
# Bridge разряжает батареи по очереди, и подсевшая/мёртвая батарея с нулём, но
# ненулевым energy_full иначе занижала бы общий %.
#
# Запускается из autostart.lua.
set -uo pipefail

INTERVAL=60          # секунд между проверками
NOTIFY_ID=9990       # фиксированный id → уведомления заменяют друг друга, а не копятся

notified=99          # самый низкий уже показанный порог (99 = ничего; сброс на зарядке)

ac_online() {
  local ac
  for ac in /sys/class/power_supply/A{C,DP}*/online; do
    [ -r "$ac" ] && [ "$(cat "$ac")" = "1" ] && return 0
  done
  return 1
}

battery_percent() {
  # Процент САМОЙ ЗАРЯЖЕННОЙ батареи (max), чтобы мёртвая/подсевшая батарея
  # не занижала результат. Нет батарей вовсе → 100 (не паникуем).
  local n f b pct max=-1
  for b in /sys/class/power_supply/BAT*; do
    if [ -r "$b/energy_now" ] && [ -r "$b/energy_full" ]; then
      n=$(cat "$b/energy_now"); f=$(cat "$b/energy_full")
    elif [ -r "$b/charge_now" ] && [ -r "$b/charge_full" ]; then
      n=$(cat "$b/charge_now"); f=$(cat "$b/charge_full")
    else
      continue
    fi
    [ "${f:-0}" -gt 0 ] || continue
    pct=$(( n * 100 / f ))
    [ "$pct" -gt "$max" ] && max=$pct
  done
  [ "$max" -lt 0 ] && max=100
  echo "$max"
}

notify() {
  local urg="$1" title="$2" body="$3"
  notify-send -a "Батарея" -u "$urg" -r "$NOTIFY_ID" "$title" "$body"
}

while true; do
  if ac_online; then
    notified=99                          # на зарядке — сбрасываем историю порогов
  else
    p=$(battery_percent)
    # уведомляем один раз на каждом пороге по мере снижения (от самого низкого)
    if   [ "$p" -le 5 ]  && [ "$notified" -gt 5 ];  then
      notify critical "🪫 Батарея ${p}%" "Подключи зарядку срочно!"
      notified=5
    elif [ "$p" -le 10 ] && [ "$notified" -gt 10 ]; then
      notify critical "🪫 Критический заряд: ${p}%" "Подключи зарядку."
      notified=10
    elif [ "$p" -le 15 ] && [ "$notified" -gt 15 ]; then
      notify critical "⚠️ Батарея ${p}%" "Заряд низкий — подключи питание."
      notified=15
    elif [ "$p" -le 20 ] && [ "$notified" -gt 20 ]; then
      notify normal "🔋 Батарея ${p}%" "Пора подумать о зарядке."
      notified=20
    fi
  fi
  sleep "$INTERVAL"
done

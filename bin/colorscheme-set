#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="$HOME/.local/state/theme/current_wallpaper"
FALLBACK="$HOME/.config/background"

if [[ -f "$STATE_FILE" ]]; then
  file="$(<"$STATE_FILE")"
  if [[ -f "$file" ]]; then
    exec "$HOME/.local/bin/theme-apply" --colors-only "$file"
  fi
fi

if [[ -f "$FALLBACK" ]]; then
  exec "$HOME/.local/bin/theme-apply" --colors-only "$FALLBACK"
fi

notify-send "Colorscheme update skipped" "No saved wallpaper found"

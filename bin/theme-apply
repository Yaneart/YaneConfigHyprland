#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="$HOME/.config/wallpapers"
STATE_DIR="$HOME/.local/state/theme"
STATE_FILE="$STATE_DIR/current_wallpaper"
LOCK_BACKGROUND="$HOME/.config/background"

colors_only=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --colors-only)
      colors_only=true
      shift
      ;;
    --help|-h)
      echo "Usage: theme-apply [--colors-only] <wallpaper>"
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -ne 1 ]]; then
  echo "Usage: theme-apply [--colors-only] <wallpaper>" >&2
  exit 1
fi

file="$1"

if [[ ! -f "$file" ]]; then
  notify-send "Theme apply failed" "Wallpaper not found: $file"
  exit 1
fi

mkdir -p "$STATE_DIR"

reload_waybar() {
  local waybar_style="$STATE_DIR/current_waybar_style"
  local waybar_dir="$HOME/.config/waybar"
  if [[ -f "$waybar_style" ]]; then
    local preset
    preset="$(cat "$waybar_style")"
    if [[ -f "$preset" ]]; then
      cat >"$waybar_dir/style.css" <<CSSEOF

/* This file is generated by ~/.local/bin/waybar-set */

@import "colors.css"; /* import matugen colors */
@import "colors-waybar.css"; /* import wallust colors */


@import url('${preset}'); /* import style  */

CSSEOF
    fi
  fi
  # waybar (reload_style_on_change) watches style.css and the imported
  # colors.css/colors-waybar.css, so rewriting style.css triggers a seamless
  # in-place CSS reload — no signal, no restart. (Full SIGUSR2 reload segfaults
  # waybar 0.15.0 with this config, so we deliberately avoid it.)
  # Only start waybar if it somehow isn't running at all.
  if ! pgrep -x waybar >/dev/null 2>&1; then
    nohup waybar >/dev/null 2>&1 &
    disown
  fi
}

reload_swaync() {
  swaync-client --reload-css >/dev/null 2>&1 || true
}

reload_kitty() {
  pkill -USR1 kitty >/dev/null 2>&1 || true
}

reload_hyprland() {
  # Обновляем ТОЛЬКО цвета рамок (единственное, что зависит от matugen в
  # Hyprland — modules/layout.lua: col.active_border = primary→tertiary,
  # col.inactive_border = background_75) через Lua-API `eval hl.config`,
  # как это делает border-auto. Полный `hyprctl reload` убран намеренно: он
  # пере-раскладывал окна (resize → kitty рисует оверлей "N by M cells",
  # рамки моргают). Правки самого конфига Hyprland подхватывает автоперезагрузкой.
  local hc="$HOME/.config/hypr/modules/generated_colors.lua"
  [[ -f "$hc" ]] || return 0
  local rx='s/.*"(rgba\([0-9a-fA-F]+\))".*/\1/'
  local prim tert inact
  prim=$(grep -E "^[[:space:]]*primary[[:space:]]*=" "$hc" | head -1 | sed -E "$rx") || true
  tert=$(grep -E "^[[:space:]]*tertiary[[:space:]]*=" "$hc" | head -1 | sed -E "$rx") || true
  inact=$(grep -E "^[[:space:]]*background_75[[:space:]]*=" "$hc" | head -1 | sed -E "$rx") || true
  [[ -n "$prim" && -n "$tert" && -n "$inact" ]] || return 0
  hyprctl eval "hl.config({ general = { col = { active_border = { colors = { \"$prim\", \"$tert\" }, angle = 45 }, inactive_border = \"$inact\" } } })" >/dev/null 2>&1 || true
}

if ! $colors_only; then
  if ! pgrep -x awww-daemon >/dev/null 2>&1; then
    nohup awww-daemon >/dev/null 2>&1 &
    sleep 0.4
  fi

  awww img "$file" \
    --transition-type any \
    --transition-duration 1.2 \
    --transition-fps 60 \
    --transition-step 50 >/dev/null 2>&1 || true

  cp "$file" "$LOCK_BACKGROUND"
fi

# Два генератора: wallust (терминальная палитра kitty + переменные
# waybar/rofi, ~0.04с) и matugen (Material You для всего остального,
# ~1.5с). pywal удалён 2026-06-13: его вывод никто не читал, а запись
# в ~/.cache/wal/colors.json гонялась с matugen-симлинком для pywalfox.
wallust run "$file" >/dev/null &
matugen image "$file" --prefer darkness >/dev/null &
wait

echo "$file" > "$STATE_FILE"

reload_waybar &
reload_swaync &
reload_kitty &
reload_hyprland &
wait


@OBSThemeMeta {
    name: 'Matugen';
    id: 'com.obsproject.Yami.Matugen';
    extends: 'com.obsproject.Yami';
    author: 'wallust';
    dark: 'true';
}

/* Generated by wallust — OBS theme = РЕАЛЬНЫЕ цвета обоев (перенесён с matugen
   24.06.2026). Акценты (--blueN) → цвета обоев, фоны (--greyN) → тёмные тона. */
@OBSThemeVars {
    /* Акцент: светлый цвет обоев для подсветок, тёмный под текст */
    --blue1: {{color5}};
    --blue2: {{color5}};
    --blue3: {{color1}};
    --blue4: {{color1}};
    --blue5: {{color1}};
    --blue6: {{color1}};

    /* Фоны: от светлого (границы/инпуты) к тёмному (превью) */
    --grey1: {{color8}};
    --grey2: {{color8}};
    --grey3: {{color0}};
    --grey4: {{color0}};
    --grey5: {{color0}};
    --grey6: {{background}};
    --grey7: {{background}};
    --grey8: {{background}};

    /* Текст */
    --text: {{foreground}};
    --text_muted: {{color8}};
}

# btop theme — РЕАЛЬНЫЕ цвета обоев из wallust (color0-15).
# Перенесён с matugen 24.06.2026 (matugen выдумывал акценты не с обоев).

theme[main_bg]=""
theme[main_fg]="{{foreground}}"
theme[title]="{{color4}}"
theme[hi_fg]="{{color6}}"
theme[selected_bg]="{{color4}}"
theme[selected_fg]="{{background}}"
theme[inactive_fg]="{{color8}}"
theme[proc_misc]="{{color6}}"

# Box outlines — каждый блок своим цветом обоев
theme[cpu_box]="{{color4}}"
theme[mem_box]="{{color6}}"
theme[net_box]="{{color5}}"
theme[proc_box]="{{color3}}"

theme[div_line]="{{color8}}"

# Temperature graph — от тусклого к яркому цвету обоев
theme[temp_start]="{{color2}}"
theme[temp_mid]="{{color4}}"
theme[temp_end]="{{color6}}"

# CPU graph
theme[cpu_start]="{{color3}}"
theme[cpu_mid]="{{color4}}"
theme[cpu_end]="{{color6}}"

# Mem/Disk free meter
theme[free_start]="{{color5}}"
theme[free_mid]=""
theme[free_end]="{{color2}}"

# Mem/Disk cached meter
theme[cached_start]="{{color6}}"
theme[cached_mid]=""
theme[cached_end]="{{color3}}"

# Mem/Disk available meter
theme[available_start]="{{color4}}"
theme[available_mid]=""
theme[available_end]="{{color2}}"

# Mem/Disk used meter
theme[used_start]="{{color1}}"
theme[used_mid]="{{color3}}"
theme[used_end]="{{color5}}"

# Download graph
theme[download_start]="{{color5}}"
theme[download_mid]="{{color4}}"
theme[download_end]="{{color6}}"

# Upload graph
theme[upload_start]="{{color3}}"
theme[upload_mid]="{{color4}}"
theme[upload_end]="{{color6}}"

{
    "layer": "top",
    // "height": 10,
    "font": "JetBrainsMono Nerd Font 10",
    "reload_style_on_change": true,
    "modules-left": [
        "clock",
        "custom/temperature",
        "custom/light",
        "network",
        "bluetooth"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "mpris",
        // "cava",
        "backlight",
        "pulseaudio",
        "battery",
        "custom/swaync",
        "tray",
        
    ],
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "interval": 30,
        "tooltip-format": "{timeTo}\n{power:0.1f} W",
        "format": "{capacity}% {icon}",
        "on-click": "$HOME/.local/bin/eww-battery-popup",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-charging": "{capacity}% {icon} ",
    }, "clock": {
        "format": "{:%H:%M}  ",
        "tooltip": false,
        "on-click": "$HOME/.local/bin/eww-dashboard"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "persistent-workspaces": {
            "*": 6, // 5 workspaces by default on every monitor
            "HDMI-A-1": 3 // but only three on HDMI-A-1
        }
    },
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "bluetooth": {
        "on-click": "blueman-manager",
        "format": "bluetooth {icon}",
        "format-icons": {
            "enabled": "",
            "disabled": ""
        },
        "tooltip-format": "{device_alias}"
    },

    "network": {
        "interface": "wlp3s0",
        "on-click": "nm-connection-editor",
        "format": "{ifname}",
        "format-wifi": "{essid} ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "format-disconnected": "wifi 󰖪",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% {icon}",
        "format-icons": [
            "",
            ""
        ],
        "format-alt": "{percent}% {icon}",
        "on-click": "brightnessctl set +10%",
        "on-click-right": "brightnessctl set 10%-",
        "on-scroll-up": "brightnessctl set +1%",
        "on-scroll-down": "brightnessctl set 1%-",
        "scroll-step": 1,
        "tooltip": false
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "icons": {
            "blueman": "bluetooth",
            "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        }
    },
    "mpris": {
        "player": "spotify",
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "",
            "spotify": ""
        },
        "status-icons": {
            "playing": "",
            "paused": ""
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-len": 28,
        "dynamic-separator": "  ·  ",
        "tooltip-format": "{title}\n{artist}\n{album}",
        "max-length": 42,
        "interval": 5,
        "on-click": "eww open --toggle music",
        "on-click-right": "playerctl -p spotify play-pause",
        "on-click-middle": "spotify-launcher",
        "on-scroll-up": "playerctl -p spotify next",
        "on-scroll-down": "playerctl -p spotify previous"
    },
    "cava": {
        "framerate": 30,

        // "autosens": ,
        "sensitivity": 1,
        "bars": 20,
        "lower_cutoff_freq": 50,
        "higher_cutoff_freq": 10000,
        "hide_on_silence": true,
        // через 5с тишины модуль засыпает (почти нулевой CPU), при звуке просыпается
        "sleep_timer": 5,
        // "format_silent": "quiet",
        "method": "pulse",
        "source": "auto",
        "stereo": true,
        "reverse": true,
        "bar_delimiter": 0,
        "monstercat": false,
        "waves": true,
        "noise_reduction": 0.77,
        "input_delay": 2,
        "format-icons": ["⠀", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
                   "on-click-right": "mode"
                   }
        
    },
    "custom/swaync": {
        "tooltip": true,
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚",
            "inhibited-none": "󰂜",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/temperature":{
        "exec": "bash ~/.config/waybar/scripts/waybar-light-controls/show_temperature.sh",
        "interval": 2,
        "format": "󰔄 {}",
        "tooltip": false,
        "on-scroll-up": "bash ~/.config/waybar/scripts/waybar-light-controls/temperature_control.sh up",
        "on-scroll-down": "bash ~/.config/waybar/scripts/waybar-light-controls/temperature_control.sh down",
},

"custom/light":{
        "exec": "bash ~/.config/waybar/scripts/waybar-light-controls/show_light.sh",
        "interval": 2,
        "format": "󰃟 {}",
        "tooltip": false,
        "on-scroll-up": "bash ~/.config/waybar/scripts/waybar-light-controls/light_control.sh up",
        "on-scroll-down": "bash ~/.config/waybar/scripts/waybar-light-controls/light_control.sh down",
},








}

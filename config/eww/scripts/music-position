#!/usr/bin/env bash
# defpoll source: current playback position as 0–100 percentage.
set -u
PLAYER="spotify"

pos="$(playerctl -p "$PLAYER" position 2>/dev/null)"
len="$(playerctl -p "$PLAYER" metadata mpris:length 2>/dev/null)"  # microseconds

if [ -z "$pos" ] || [ -z "$len" ] || [ "$len" -le 0 ] 2>/dev/null; then
  echo 0
  exit 0
fi

awk -v p="$pos" -v l="$len" 'BEGIN { printf "%.1f", (p / (l / 1000000)) * 100 }'

;; ── Music popup ──────────────────────────────────────────────
;; Live now-playing data from Spotify (event-driven via playerctl --follow).
(deflisten music
  :initial `{"status":"Stopped","title":"Ничего не играет","artist":"","cover":"","blur":""}`
  "bash ~/.config/eww/scripts/music-info")

;; Playback position 0–100 for the progress bar.
(defpoll pos :interval "1s" :initial "0" "bash ~/.config/eww/scripts/music-position")

(defwidget player []
  (overlay
    ;; blurred album art fills the popup
    (image :class "bg" :path {music.blur} :image-width 340 :image-height 480)
    ;; translucent scrim + content on top, filling the whole popup
    (box :class "content" :orientation "v" :space-evenly false
         :halign "fill" :valign "fill" :hexpand true :vexpand true
      (box :valign "center" :vexpand true :orientation "v" :space-evenly false :halign "center"
        (image :class "cover" :path {music.cover} :image-width 240 :image-height 240)
        (label :class "title"  :halign "center" :limit-width 24 :text {music.title})
        (label :class "artist" :halign "center" :limit-width 28 :text {music.artist})
        (scale :class "progress" :value pos :min 0 :max 100 :active false)
        (box :class "controls" :orientation "h" :halign "center" :space-evenly false :spacing 22
          (button :class "btn"      :onclick "playerctl -p spotify previous"   "󰒮")
          (button :class "btn play" :onclick "playerctl -p spotify play-pause"
            {music.status == "Playing" ? "󰏤" : "󰐊"})
          (button :class "btn"      :onclick "playerctl -p spotify next"       "󰒭"))))))

(defwindow music
  :monitor 0
  :stacking "overlay"
  ;; 480px: the content needs ~460px; at 430 the card overflowed the surface
  ;; and its rounded bottom corners were clipped into square ones
  :geometry (geometry :x "8px" :y "8px" :anchor "top right" :width "340px" :height "480px")
  (player))

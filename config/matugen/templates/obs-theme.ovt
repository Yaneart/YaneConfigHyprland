@OBSThemeMeta {
    name: 'Matugen';
    id: 'com.obsproject.Yami.Matugen';
    extends: 'com.obsproject.Yami';
    author: 'matugen';
    dark: 'true';
}

/* Generated by matugen — OBS theme matched to the current wallpaper.
   Do not edit by hand: regenerated on every theme-apply / wallpaper change.
   Переопределяем палитру базовой Yami: акценты (--blueN) → primary matugen,
   фоны (--greyN) → поверхности matugen. Тёмные акценты для читаемости
   светлого текста на выделении. */
@OBSThemeVars {
    /* Акцент: светлый primary для подсветок, тёмный primary_container под текст */
    --blue1: {{colors.primary.default.hex}};
    --blue2: {{colors.primary.default.hex}};
    --blue3: {{colors.primary_container.default.hex}};
    --blue4: {{colors.primary_container.default.hex}};
    --blue5: {{colors.primary_container.default.hex}};
    --blue6: {{colors.primary_container.default.hex}};

    /* Фоны: от светлого (границы/инпуты) к тёмному (превью) */
    --grey1: {{colors.outline.default.hex}};
    --grey2: {{colors.outline_variant.default.hex}};
    --grey3: {{colors.surface_variant.default.hex}};
    --grey4: {{colors.surface_container_highest.default.hex}};
    --grey5: {{colors.surface_container_high.default.hex}};
    --grey6: {{colors.surface_container.default.hex}};
    --grey7: {{colors.surface_container_low.default.hex}};
    --grey8: {{colors.surface_container_lowest.default.hex}};

    /* Текст */
    --text: {{colors.on_surface.default.hex}};
    --text_muted: {{colors.on_surface_variant.default.hex}};
}

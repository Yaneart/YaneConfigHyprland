/*
 * Тема rofi для askpass (sudo -A). Импортирует ТОЛЬКО matugen-палитру
 * (не mainStyle — он навязывает фикс-высоту 560px). Высота окна не задана,
 * поэтому rofi облегает содержимое: строка-сообщение + поле пароля с замком.
 */
@import "~/.config/rofi/colors/colors-matugen.rasi"
@import "~/.config/rofi/colors/colors-wallust.rasi"

configuration {
    show-icons: false;
}

* {
    background-color: transparent;
    text-color:       @on-surface;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    transparency:     "real";
    width:            440px;
    location:         center;
    anchor:           center;
    border:           1px solid;
    border-radius:    22px;
    border-color:     @outline-variant-25;
    background-color: @surface-container;
    cursor:           "default";
}

mainbox {
    padding:  0px;
    spacing:  0px;
    children: [ "inputbar" ];
}

inputbar {
    spacing:          10px;
    padding:          14px 18px;
    margin:           18px 20px;
    border-radius:    999px;
    background-color: @surface-container-high;
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:           false;
    str:              "";
    padding:          0px 6px 0px 2px;
    background-color: transparent;
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font 18";
    vertical-align:   0.5;
}

entry {
    background-color:  transparent;
    text-color:        @on-surface;
    cursor:            text;
    placeholder:       "пароль…";
    placeholder-color: @outline;
    font:              "JetBrainsMono Nerd Font 15";
    vertical-align:    0.5;
}

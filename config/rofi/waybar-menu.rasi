@import "~/.config/rofi/mainStyle.rasi"

configuration { show-icons: false; }

// height: inherit + dynamic listview → окно подгоняется под число пунктов,
// нет пустого места снизу (как в menu-list.rasi для WiFi/BT)
window { width: 460px; height: inherit; }

mainbox {
    spacing:  0px;
    padding:  0px;
    children: [ "message", "listview" ];
}

listview {
    lines:         8;
    dynamic:       true;
    fixed-height:  false;
    spacing:       4px;
    padding:       10px;
    border-radius: 0px 0px 28px 28px;
}

element-text {
    horizontal-align: 0.5;
    padding:          14px 20px;
    font:             "JetBrainsMono Nerd Font 14";
}
